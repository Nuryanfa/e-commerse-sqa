DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=ecommerce_sqa
DB_PORT=5432

# [SECURITY WAJIB] JWT Secret — HARUS diisi, minimal 32 karakter
# Generate: openssl rand -base64 64
# JANGAN gunakan secret yang mengandung nama project atau tahun!
JWT_SECRET=YOUR_STRONG_JWT_SECRET_MIN_32_CHARS

REDIS_ADDR=localhost:6379
# [SECURITY WAJIB] Set password Redis untuk mencegah unauthorized access
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# [SECURITY] Dapatkan dari https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
# Gunakan "sandbox" untuk pengujian atau "production" untuk transaksi nyata.
MIDTRANS_ENV=sandbox

# [SECURITY] URL frontend untuk redirect setelah pembayaran. Sesuaikan port jika berbeda.
APP_FRONTEND_URL=http://localhost:5173

# Pisahkan beberapa origin dengan koma. Jangan gunakan wildcard di production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

APP_PORT=8080
# [SECURITY WAJIB] Set ke 'release' di production — menonaktifkan Swagger dan debug output
GIN_MODE=release

# [MONITORING] Telegram Alerts untuk Notifikasi Server Error (Opsional)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
